# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=info

# ── gRPC ──
GRPC_HOST=0.0.0.0
GRPC_PORT=5003

# ── HTTP (health only; not exposed publicly) ──
HTTP_HOST=0.0.0.0
HTTP_PORT=8083

# ── Postgres (Prisma) ──
# Match infra/.env — order_svc / changeme / order_db on order-db:5432 inside the compose network.
DATABASE_URL=postgresql://order_svc:changeme@localhost:5433/order_db?schema=public

# ── Kafka (producer for order.* topics via the outbox relay — ORD-8) ──
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-service

# ── Outbox relay (ORD-8) ──
# Polls the `outbox` table with FOR UPDATE SKIP LOCKED, publishes to Kafka,
# marks rows sent. Safe to run in multiple pods (locks are per-row, skipped by
# peers). Set OUTBOX_RELAY_ENABLED=false in one-off admin containers.
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_POLL_INTERVAL_MS=250
OUTBOX_RELAY_BATCH_SIZE=32
OUTBOX_RELAY_ERROR_BACKOFF_MS=5000

# ── gRPC clients (ORD-3) ──
USER_SERVICE_URL=localhost:5001
PRODUCT_SERVICE_URL=localhost:5002
